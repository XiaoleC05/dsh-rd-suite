{
  "version": 1,
  "lineEnding": "lf",
  "finalNewline": true,
  "maxBlankLines": 1,
  "id": "html",
  "label": "HTML",
  "language": "html",
  "engine": "biome",
  "depth": "format",
  "indentStyle": "space",
  "indentWidth": 2,
  "columnLimit": 100,
  "biomeConfig": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 100
    },
    "html": {
      "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 2,
        "lineWidth": 100
      }
    }
  },
  "experimentalHtml": true,
  "rules": [
    {
      "id": "html/F/format",
      "name": "格式绑定 Biome（空格 2 / 100 列）",
      "category": "F",
      "tier": "T2",
      "source": "https://biomejs.dev/formatter/",
      "fix": "auto"
    },
    {
      "id": "html/F/lowercase",
      "name": "标签名与属性名小写",
      "category": "F",
      "tier": "T3",
      "source": "https://google.github.io/styleguide/htmlcssguide.html",
      "fix": "report"
    },
    {
      "id": "html/F/attr-quote",
      "name": "属性值使用双引号",
      "category": "F",
      "tier": "T3",
      "source": "https://google.github.io/styleguide/htmlcssguide.html",
      "fix": "auto"
    },
    {
      "id": "html/F/doctype",
      "name": "使用 HTML5 doctype",
      "category": "F",
      "tier": "T3",
      "source": "https://google.github.io/styleguide/htmlcssguide.html",
      "fix": "report"
    },
    {
      "id": "html/F/void-slash",
      "name": "void 元素结尾斜杠风格全项目一致",
      "category": "F",
      "tier": "T2",
      "source": "https://biomejs.dev/formatter/",
      "fix": "auto"
    },
    {
      "id": "html/X/no-official-style",
      "name": "WHATWG 只定义语法，不规定缩进与引号偏好",
      "category": "X",
      "tier": "T1",
      "source": "https://html.spec.whatwg.org/multipage/syntax.html",
      "fix": "none"
    }
  ]
}
