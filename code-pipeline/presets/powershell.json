    {
      "id": "ps/F/line-ending",
      "name": "LF 行尾",
      "category": "F",
      "tier": "T0",
      "source": "",
      "fix": "auto"
    },
    {
      "id": "ps/F/final-newline",
      "name": "文件末尾单个换行",
      "category": "F",
      "tier": "T0",
      "source": "",
