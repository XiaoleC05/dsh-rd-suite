{
  "version": 1,
  "lineEnding": "lf",
  "finalNewline": true,
  "maxBlankLines": 1,
  "id": "cpp",
  "label": "C++",
  "language": "cpp",
  "engine": "clang-format",
  "depth": "format",
  "indentStyle": "space",
  "indentWidth": 2,
  "columnLimit": 100,
  "clangStyle": {
    "BasedOnStyle": "Google",
    "IndentWidth": 2,
    "ColumnLimit": 100,
    "DerivePointerAlignment": false,
    "PointerAlignment": "Left",
    "SortIncludes": "CaseSensitive"
  },
  "rules": [
    {
      "id": "cpp/F/clang-format",
      "name": "格式以 clang-format 输出为准（基于 Google 风格，2 空格 / 100 列）",
      "category": "F",
      "tier": "T2",
      "source": "https://clang.llvm.org/docs/ClangFormatStyleOptions.html",
      "fix": "auto"
    },
    {
      "id": "cpp/F/pointer-align",
      "name": "指针与引用符号贴近类型",
      "category": "F",
      "tier": "T3",
      "source": "https://google.github.io/styleguide/cppguide.html",
      "fix": "auto"
    },
    {
      "id": "cpp/F/include-sort",
      "name": "include 排序",
      "category": "F",
      "tier": "T3",
      "source": "https://google.github.io/styleguide/cppguide.html",
      "fix": "auto"
    },
    {
      "id": "cpp/S/naming",
      "name": "类型 PascalCase、函数 CamelCase、成员变量后缀下划线",
      "category": "S",
      "tier": "T3",
      "source": "https://google.github.io/styleguide/cppguide.html",
      "fix": "report"
    },
    {
      "id": "cpp/X/no-official-style",
      "name": "C++ 无官方风格规范，Google 风格为事实标准",
      "category": "X",
      "tier": "T1",
      "source": "https://isocpp.org/",
      "fix": "none"
    }
  ]
}
