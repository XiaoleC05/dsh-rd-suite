{
  "version": 1,
  "lineEnding": "lf",
  "finalNewline": true,
  "maxBlankLines": 1,
  "id": "go",
  "label": "Go",
  "language": "go",
  "engine": "gofmt",
  "depth": "format",
  "indentStyle": "tab",
  "indentWidth": 4,
  "columnLimit": 0,
  "rules": [
    {
      "id": "go/F/gofmt",
      "name": "文件格式以 gofmt 输出为准",
      "category": "F",
      "tier": "T2",
      "source": "https://pkg.go.dev/cmd/gofmt",
      "fix": "auto"
    },
    {
      "id": "go/F/semicolons",
      "name": "不手写分号，交由 ASI 插入",
      "category": "F",
      "tier": "T1",
      "source": "https://go.dev/ref/spec#Semicolons",
      "fix": "auto"
    },
    {
      "id": "go/F/import-group",
      "name": "import 分组，标准库独立成组",
      "category": "F",
      "tier": "T1",
      "source": "https://go.dev/wiki/CodeReviewComments#imports",
      "fix": "auto"
    },
    {
      "id": "go/F/line-ending",
      "name": "LF 行尾、文件末尾单个换行",
      "category": "F",
      "tier": "T2",
      "source": "https://pkg.go.dev/cmd/gofmt",
      "fix": "auto"
    },
    {
      "id": "go/S/mixed-caps",
      "name": "多词标识符用 MixedCaps，不用下划线",
      "category": "S",
      "tier": "T1",
      "source": "https://go.dev/doc/effective_go",
      "fix": "report"
    },
    {
      "id": "go/S/initialisms",
      "name": "缩略词大小写一致：URL、ID、ServeHTTP",
      "category": "S",
      "tier": "T1",
      "source": "https://go.dev/wiki/CodeReviewComments",
      "fix": "report"
    },
    {
      "id": "go/S/package-name",
      "name": "包名小写、短、单字",
      "category": "S",
      "tier": "T1",
      "source": "https://go.dev/doc/effective_go",
      "fix": "report"
    },
    {
      "id": "go/S/doc-comment",
      "name": "导出名有 doc comment，完整句并以名字开头",
      "category": "S",
      "tier": "T1",
      "source": "https://go.dev/doc/comment",
      "fix": "report"
    },
    {
      "id": "go/S/error-string",
      "name": "error 字符串不大写、不以标点结尾",
      "category": "S",
      "tier": "T1",
      "source": "https://go.dev/wiki/CodeReviewComments",
      "fix": "report"
    },
    {
      "id": "go/X/error-handling",
      "name": "不用 _ 丢弃 error，普通错误不 panic",
      "category": "X",
      "tier": "T1",
      "source": "https://go.dev/wiki/CodeReviewComments",
      "fix": "none"
    }
  ]
}
